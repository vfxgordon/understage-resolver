#ifndef ASSETLIBRESOLVER_CONFIG_H
#define ASSETLIBRESOLVER_CONFIG_H

/// URI scheme the resolver is registered for, without the colon.
/// Also written into plugInfo.json ("uriSchemes").
#define ASSETLIB_URI_SCHEME "@ASSETLIB_URI_SCHEME@"

/// Environment variable holding the library root directory, used when the
/// bound context does not set one.
#define ASSETLIB_ROOT_ENV_VAR "@ASSETLIB_ROOT_ENV_VAR@"

/// Environment variable naming a release manifest to use as the default
/// context.
#define ASSETLIB_MANIFEST_ENV_VAR "@ASSETLIB_MANIFEST_ENV_VAR@"

/// Environment variable that, when set to anything but "0", disables all
/// remote (backend) access: libraries use only what is already cached.
#define ASSETLIB_OFFLINE_ENV_VAR "@ASSETLIB_OFFLINE_ENV_VAR@"

/// Per-library configuration file, at the library root. Configures the
/// remote backend; a library without one is local-only.
#define ASSETLIB_CONFIG_FILE "@ASSETLIB_CONFIG_FILE@"

/// Provenance record written into each fetched version directory.
#define ASSETLIB_PROVENANCE_FILE "@ASSETLIB_PROVENANCE_FILE@"

#endif
